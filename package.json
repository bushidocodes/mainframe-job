{
  "name": "zos-jes",
  "version": "2.0.0",
  "description": "Submit JCL jobs to the z/OS Job Entry Subsystem (JES) over FTP from Node.js.",
  "keywords": [
    "mainframe",
    "zos",
    "z/OS",
    "jes",
    "jcl",
    "ftp",
    "ibm"
  ],
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushidocodes/mainframe-job.git"
  },
  "homepage": "https://github.com/bushidocodes/mainframe-job#readme",
  "bugs": {
    "url": "https://github.com/bushidocodes/mainframe-job/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && tsc --project tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "basic-ftp": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
